# ==============================================================================
# DX-LAB (DX-OS) - Environment Configuration Template (.env.example)
#
# Instructions:
# 1. Copy this file to create your local .env:
#    cp .env.example .env
# 2. Update passwords and secret keys with strong values before starting services.
# 3. .env is ignored by Git and will not leak credentials (AR-24, NFR-14).
#
# Copyright (C) 2026 DX-LAB Development Team
# License: AGPL-3.0
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MÔI TRƯỜNG & PROFILE HOẠT ĐỘNG (AR-14, AR-24)
# ------------------------------------------------------------------------------
# Môi trường chạy: dev | test | demo
ENVIRONMENT=dev

# Profile mặc định cho Docker Compose: core | demo | ai
#   - core: P-Process + PostgreSQL (nhẹ, nhanh, không cần AI)
#   - demo: core + Caddy + Keycloak + Odoo + Node-RED + Superset + Mailpit
#   - ai: core + Qdrant + Haystack RAG; OpenRouter is external
COMPOSE_PROFILES=core

# ------------------------------------------------------------------------------
# 2. CỔNG VÀO CÔNG KHAI CADDY (AD-11)
# ------------------------------------------------------------------------------
DOMAIN=localhost
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
DX_PUBLIC_ORIGIN=https://localhost

# ------------------------------------------------------------------------------
# 3. CƠ SỞ DỮ LIỆU POSTGRESQL (TẦNG D)
# ------------------------------------------------------------------------------
POSTGRES_DB=dxlab_db
POSTGRES_USER=dxlab_admin
# THAY ĐỔI mật khẩu này trong tệp .env của bạn
POSTGRES_PASSWORD=dxlab_postgres_password_2026

# ------------------------------------------------------------------------------
# 4. DỊCH VỤ LÕI TIẾN TRÌNH P (TẦNG P)
# ------------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
TICKET_TYPE_GROUP_MAPPING={"Khiếu nại":"complaints","Tư vấn":"consulting","Bảo hành":"warranty"}
# Comma-separated ISO dates excluded from Asia/Ho_Chi_Minh business hours.
SLA_HOLIDAYS=
# Canonical browser-visible issuer; backchannel URLs below keep Docker DNS.
OIDC_ISSUER=https://localhost/realms/dxlab
OIDC_AUDIENCE=p-process
OIDC_INTROSPECTION_URL=http://keycloak:8080/realms/dxlab/protocol/openid-connect/token/introspect
OIDC_TOKEN_URL=http://keycloak:8080/realms/dxlab/protocol/openid-connect/token
OIDC_ADMIN_BASE_URL=http://keycloak:8080/admin/realms/dxlab
OIDC_CLIENT_ID=p-process
# Chỉ đặt secret thật trong .env bị bỏ qua hoặc secret store.
OIDC_CLIENT_SECRET=p-process-dev-secret
OIDC_TRUSTED_CLIENT_IDS=web,odoo

# ------------------------------------------------------------------------------
# 5. QUẢN TRỊ ĐỊNH DANH KEYCLOAK OIDC (AD-5)
# ------------------------------------------------------------------------------
KEYCLOAK_ADMIN=admin
# THAY ĐỔI mật khẩu quản trị Keycloak trong tệp .env của bạn
KEYCLOAK_ADMIN_PASSWORD=dxlab_keycloak_admin_2026
KEYCLOAK_DB=dxlab_keycloak
KEYCLOAK_PUBLIC_URL=https://localhost

# ------------------------------------------------------------------------------
# 6. QUẢN TRỊ DOANH NGHIỆP ODOO ERP (TẦNG H)
# ------------------------------------------------------------------------------
ODOO_DB_USER=odoo
# THAY ĐỔI mật khẩu Odoo trong tệp .env của bạn
ODOO_DB_PASSWORD=odoo_secure_password_2026
ODOO_P_API_BASE_URL=http://p-process:3000
ODOO_OIDC_TOKEN_URL=http://keycloak:8080/realms/dxlab/protocol/openid-connect/token
ODOO_P_CLIENT_ID=odoo
ODOO_P_CLIENT_SECRET=odoo-dev-secret

# ------------------------------------------------------------------------------
# 7. TRỰC QUAN HÓA APACHE SUPERSET (TẦNG D)
# ------------------------------------------------------------------------------
# Khóa bí mật sinh ngẫu nhiên dùng mã hóa session Superset
SUPERSET_SECRET_KEY=superset-secret-key-production-change-2026

# ------------------------------------------------------------------------------
# 8. TEST DOUBLES / MAILPIT (HỘP THƯ KIỂM THỬ)
# ------------------------------------------------------------------------------
SMTP_HOST=mailpit
ATTACHMENT_STORAGE_PATH=/app/private-attachments
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ------------------------------------------------------------------------------
# 9. DỊCH VỤ TRÍ TUỆ NHÂN TẠO & RAG (TẦNG I - DÀNH CHO PROFILE 'ai')
# ------------------------------------------------------------------------------
AI_PROVIDER=openrouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Set only in your ignored .env or secret store. Never commit a real key.
OPENROUTER_API_KEY=
OPENROUTER_TIMEOUT_SECONDS=30
QDRANT_HOST=qdrant
QDRANT_PORT=6333
