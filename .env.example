# ==============================================================================
# DX-LAB (DX-OS) - Environment Configuration Template
# Olympic Tin học Sinh viên PMNM 2026
#
# Copy this file to .env and adjust variables as needed:
# cp .env.example .env
# ==============================================================================

# --- General System Settings ---
COMPOSE_PROJECT_NAME=dx-lab
APP_ENV=development
SECRET_KEY=dx-lab-secret-key-change-in-production-2026

# --- Layer H: Human / ERP (Odoo) ---
ODOO_PORT=8069
ODOO_ADMIN_PASSWORD=admin_dxlab_2026
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=odoo_secure_password_2026

# --- Layer P: Process (Node-RED) ---
NODE_RED_PORT=1880
NODE_RED_CREDENTIAL_SECRET=nodered_encryption_key_2026
NODE_RED_FLOW_FILE=flows.json

# --- Layer D: Data & Analytics (PostgreSQL & Superset) ---
POSTGRES_DB=dxlab_db
POSTGRES_USER=dxlab_admin
POSTGRES_PASSWORD=dxlab_postgres_password_2026
POSTGRES_PORT=5432

SUPERSET_PORT=8088
SUPERSET_SECRET_KEY=superset-secret-key-production-change-2026
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin_dxlab

# --- Layer I: Intelligence (Qdrant, Haystack, Ollama) ---
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

HAYSTACK_API_PORT=8000
HAYSTACK_LOG_LEVEL=INFO

OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b
EMBEDDING_MODEL=bge-m3
