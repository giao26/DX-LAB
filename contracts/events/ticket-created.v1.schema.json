{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dx-lab.org/schemas/events/ticket-created.v1.schema.json",
  "title": "TicketCreatedV1",
  "description": "Payload schema for ticket.created.v1 integration event",
  "type": "object",
  "required": [
    "ticket_id",
    "ticket_code",
    "customer_id",
    "provisional_type",
    "contact_review_required",
    "created_at"
  ],
  "properties": {
    "ticket_id": {
      "type": "string",
      "format": "uuid"
    },
    "ticket_code": {
      "type": "string",
      "pattern": "^TCK-[0-9]{4}-[0-9]+$"
    },
    "customer_id": {
      "type": "string",
      "format": "uuid"
    },
    "provisional_type": {
      "type": "string",
      "enum": ["Khiếu nại", "Tư vấn", "Bảo hành"]
    },
    "contact_review_required": {
      "type": "boolean"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
